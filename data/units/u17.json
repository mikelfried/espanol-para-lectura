      "pos": "n.",
      "en": "teacher (school); master",
      "he": "מורה",
      "note": "el profesor teaches at secondary or university level.",
      "ex": [
        {
          "tag": "teacher",
          "es": "Mi hermana es maestra.",
          "en": "My sister is a teacher."
        },
        {
          "tag": "master",
          "es": "Es un maestro de la guitarra.",
          "en": "He is a master of the guitar."
        }
      ]
    },
    {
      "es": "el abogado / la abogada",
      "pos": "n.",
      "en": "lawyer",
      "ex": [
        {
          "es": "Consultamos a una abogada.",
          "en": "We consulted a lawyer."
        }
      ]
    },
    {
      "es": "el ingeniero / la ingeniera",
      "pos": "n.",
      "en": "engineer",
      "ex": [
        {
          "es": "Trabaja como ingeniero de software.",
          "en": "He works as a software engineer."
        }
      ]
    },
    {
      "es": "el obrero / la obrera",
      "pos": "n.",
      "en": "manual worker, labourer",
