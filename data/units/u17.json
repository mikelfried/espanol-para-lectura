{
  "id": "u17",
  "title": "Work and jobs",
  "intro": "Professions drop the article after ser: es maestra, not es una maestra. Adding the article turns it into an emphatic judgement — ¡es un artista! meaning he's a real artist.",
  "entries": [
    {
      "es": "el trabajo",
      "pos": "n.m.",
      "en": "work, job; piece of work",
      "he": "עבודה",
      "ex": [
        {
          "tag": "job",
          "es": "Encontró trabajo en un banco.",
          "en": "She found a job at a bank."
        },
        {
          "tag": "piece of work",
          "es": "Entregué el trabajo tarde.",
          "en": "I handed the assignment in late."
        }
      ]
    },
    {
      "es": "la empresa",
      "pos": "n.f.",
      "en": "company, firm",
      "note": "la compañía is a synonym; el negocio is a business or a deal.",
      "ex": [
        {
          "es": "La empresa tiene cien empleados.",
          "en": "The company has a hundred employees."
        }
      ]
    },
    {
      "es": "la oficina",
      "pos": "n.f.",
      "en": "office",
      "ex": [
        {
          "es": "La oficina cierra a las seis.",
          "en": "The office closes at six."
        }
      ]
    },
    {
      "es": "el empleo",
      "pos": "n.m.",
      "en": "employment, job",
      "note": "el empleado is the employee; el desempleo unemployment.",
      "ex": [
        {
          "es": "Busca empleo desde enero.",
          "en": "He's been looking for work since January."
        }
      ]
    },
    {
      "es": "el sueldo",
      "pos": "n.m.",
      "en": "salary, wage",
      "note": "el salario is the formal word; la paga what you actually get.",
      "ex": [
        {
          "es": "Le subieron el sueldo.",
          "en": "They raised his salary."
        }
      ]
    },
    {
      "es": "la reunión",
      "pos": "n.f.",
      "en": "meeting, gathering",
      "note": "Plural reuniones loses the accent.",
      "ex": [
        {
          "es": "La reunión se canceló.",
          "en": "The meeting was cancelled."
        }
      ]
    },
    {
